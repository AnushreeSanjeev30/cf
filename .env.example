# Public URL of the site (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://canaraflex.com

# Enquiry emails are sent through Resend (https://resend.com).
# If RESEND_API_KEY is not set, enquiries are only logged to the server console.
RESEND_API_KEY=
ENQUIRY_TO=sanjeevflex@gmail.com
ENQUIRY_FROM="Canara Flex Website <enquiries@canaraflex.com>"

# Enquiries are also recorded in a Google Sheet (see "Enquiry sheet" in README.md).
# SHEET_WEBHOOK_URL is the Apps Script web app URL; the secret must match the
# SECRET script property set in Apps Script.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
